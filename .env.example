# Docker 部署配置（复制为 .env）
# heihuo8/ARTEX 发布的 GHCR 镜像；参见 README 的部署说明。
ARTEX_IMAGE=ghcr.io/heihuo8/artex
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# HTTP User-Agent；留空时从浏览器 UA 样本中随机抽选，填写则使用固定值
ARTEX_HTTP_USER_AGENT=
